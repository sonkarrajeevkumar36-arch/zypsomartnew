rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'sonkarrajeevkumar36@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // Public catalog read, authenticated admin write
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{prodId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shopControl/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer orders
    match /orders/{orderId} {
      // Users can only read their own orders; admins can read all
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());

      // Authenticated users can create orders for themselves
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // Customers can only update their own order status for cancellations or return requests
      // Admins can update all fields/statuses
      allow update: if isAuthenticated() && (
        (
          resource.data.userId == request.auth.uid &&
          (
            request.resource.data.status in ['cancelled', 'return_requested', 'return_pending']
          )
        ) || isAdmin()
      );

      // Only administrators can delete orders
      allow delete: if isAdmin();
    }
  }
}
